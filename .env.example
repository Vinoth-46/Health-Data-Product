# ==============================================================================
# Environment Configuration: Red Hat Ecosystem Health Data Product
# ==============================================================================

# Airflow Core Settings
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.2-python3.11
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false

# PostgreSQL Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Analytics Data Warehouse Database (PostgreSQL)
ANALYTICS_DB=analytics_dw
ANALYTICS_USER=analytics_user
ANALYTICS_PASSWORD=analytics_password
ANALYTICS_HOST=postgres
ANALYTICS_PORT=5432

# External APIs
# GitHub Personal Access Token (Optional: increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# LLM API Configuration (Provide either GEMINI_API_KEY or ANTHROPIC_API_KEY)
# If left blank, a high-fidelity deterministic heuristic synthesizer activates automatically
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Target Red Hat Ecosystem Repositories (comma-separated owner/repo)
TARGET_REPOSITORIES=ansible/ansible,openshift/origin,redhat-developer/vscode-yaml,ansible/awx
